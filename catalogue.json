      "sections": [
        {
          "lines": [
            {
              "en": "My royal day can be a royal bore,",
              "zh": "我这王室日常无聊透顶"
            },
            {
              "en": "It leaves me colder than a basement floor!",
              "zh": "冷得比地窖的地板还冰"
            },
            {
              "en": "The only moment I keep waiting for",
              "zh": "我唯一盼着的那一刻"
            },
            {
              "en": "Is when the day will be through.",
              "zh": "就是这一天终于过完"
            }
          ]
        },
        {
          "lines": [
            {
              "en": "I never notice if it’s dark or clear,",
              "zh": "天晴天阴我全不在意"
            },
            {
              "en": "What people say to me I hardly hear,",
              "zh": "别人对我说话我也几乎听不见"
            },
            {
              "en": "The passing hours are an endless year,",
              "zh": "流逝的时光漫长得像一整年"
            },
            {
              "en": "Until at last I’m alone with you!",
              "zh": "直到最后，只剩我和你"
            }
          ]
        },
        {
          "lines": [
            {
              "en": "Every night at seven,",
              "zh": "每晚七点"
            },
            {
              "en": "You walk in as fresh as clover",
              "zh": "你像刚摘的苜蓿一样清新地推门进来"
            },
            {
              "en": "And I begin to sigh all over again!",
              "zh": "我又忍不住叹一口气"
            }
          ]
        },
        {
          "lines": [
            {
              "en": "Every night at seven,",
              "zh": "每晚七点"
